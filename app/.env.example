# 값은 .env.local 에 넣는다 (커밋 금지). 이 파일에는 키 이름만 둔다.

# 사이트 주소 — canonical, sitemap, OG, 메일 링크가 모두 이 값을 따른다 (PRD §5 도메인 독립성).
# 로컬 개발 기본값은 http://localhost:3000. 운영에서는 반드시 지정한다.
SITE_URL=

# 로그 수준: error | warn | info | debug (운영 기본 info)
LOG_LEVEL=

# 검색엔진 색인 허용: on 일 때만 허용한다. 공개 전·프리뷰는 비워 두거나 off.
SITE_INDEXING=

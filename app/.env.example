# 값은 .env.local 에 넣는다 (커밋 금지). 이 파일에는 키 이름만 둔다.
# SITE_URL, SITE_INDEXING, ENABLE_COMPONENT_SHOWCASE 는 빌드 때 반영된다 (값을 바꾸면 다시 빌드).

# 사이트 주소 — canonical, sitemap, OG, 메일 링크가 모두 이 값을 따른다 (PRD §5 도메인 독립성).
# 로컬 개발 기본값은 http://localhost:3000. 운영에서는 반드시 지정한다.
SITE_URL=

# 로그 수준: error | warn | info | debug (운영 기본 info)
LOG_LEVEL=

# 검색엔진 색인 허용: on 일 때만 허용한다. 공개 전·프리뷰는 비워 두거나 off.
SITE_INDEXING=

# 컴포넌트 쇼케이스(/dev/components): 개발에서는 항상 열리고, 운영에서는 on 일 때만 열린다(기본 404).
ENABLE_COMPONENT_SHOWCASE=

# 문의·소식 신청 저장소. 저장소(DB)가 정해지기 전에는 비워 둔다 → 폼은 "전송하지 못했습니다"를 보여 주고 저장하지 않는다.
# - postgres : DATABASE_URL 의 Neon Postgres 에 저장 (운영·프리뷰)
# - memory   : 개발·시험 전용 (서버를 다시 시작하면 사라진다)
INQUIRY_STORE=
# Neon 연결 문자열. 시크릿이다 — 커밋 금지. 로컬·프리뷰는 `dev` 브랜치, 운영(Vercel Production)만 `production` 브랜치 (docs/phase1/INFRASTRUCTURE.md §3).
# 마이그레이션: npm run db:migrate
DATABASE_URL=
# 같은 접속 주소의 10분당 제출 한도 (기본 10)
FORM_RATE_LIMIT=

# 어드민 인증(Better Auth) 서명 키. 32자 이상 임의 문자열, 시크릿이다 — 커밋 금지.
# 만들기(화면에 출력하지 않고 클립보드로): openssl rand -base64 32 | pbcopy
# 없으면 어드민은 "설정되지 않음"으로 닫혀 있다. 환경(로컬/프리뷰/운영)마다 다른 값을 쓴다.
BETTER_AUTH_SECRET=

# 이미지 저장소(어드민 미디어). 정해지지 않으면 업로드는 "저장소가 연결되지 않았습니다"로 닫혀 있다.
# - blob  : Vercel Blob. BLOB_READ_WRITE_TOKEN 도 필요 (Vercel 프로젝트의 Storage > Blob 에서 만든다, 시크릿)
# - local : 개발·시험 전용. app/.media-dev 폴더에 저장 (운영에서는 무시됨)
MEDIA_STORE=
BLOB_READ_WRITE_TOKEN=

# 예약 발행 크론 인증. 16자 이상 임의 문자열(시크릿). 설정하면 Vercel 크론이 Authorization 헤더로 자동 전달한다.
# 비어 있으면 /api/cron/publish 는 404 로 닫혀 있다 (예약 시각이 지나도 자동 실행되지 않음).
CRON_SECRET=

# 접수 알림 메일(Resend). 둘 다 있어야 보낸다. 시크릿이다 — 커밋 금지. 값은 Vercel 환경변수에 사람이 넣는다.
# - RESEND_API_KEY : Resend 에서 발급한 키
# - MAIL_FROM      : 인증된 발신 주소 (예: KYU <noreply@도메인>). 발신 도메인 인증(SPF·DKIM)이 끝나야 한다
# 받는 주소는 어드민 > 사이트 설정 > 연락 > 신청 알림 수신 이메일. 프리뷰(VERCEL_ENV=preview)에서는 키가 있어도 보내지 않는다.
RESEND_API_KEY=
MAIL_FROM=

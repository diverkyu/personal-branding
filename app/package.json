{
  "name": "diverkyu-site",
  "version": "0.1.0",
  "private": true,
  "description": "diverkyu.com — 이동규(KYU) 개인 브랜딩 사이트와 CMS (Phase 1)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "test:remote": "playwright test -c playwright.remote.config.ts",
    "db:cleanup-smoke": "node --env-file-if-exists=.env.local scripts/cleanup-smoke.mjs",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/admin-account.ts create",
    "admin:reset-password": "tsx --env-file-if-exists=.env.local scripts/admin-account.ts reset-password",
    "admin:reset-2fa": "tsx --env-file-if-exists=.env.local scripts/admin-account.ts reset-2fa"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.15",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "1.65.0",
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
